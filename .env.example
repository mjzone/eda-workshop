# Copy to .env to change anything. Every value below is the default, so .env is optional.

# Region for both stacks. The AgentCore harness and Gateway, the Nova inference
# profiles and S3 Vectors must all be available there.
REGION=us-east-1

# Bedrock models. Amazon Nova Pro works in a new account without a Marketplace subscription.
# It is reached through a US cross-Region inference profile.
EXTRACTION_MODEL_ID=us.amazon.nova-pro-v1:0
AGENT_MODEL_ID=us.amazon.nova-pro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Regions the US inference profiles route to (used for IAM permissions).
INFERENCE_REGIONS=us-east-1,us-east-2,us-west-2

# Guardrail tier. STANDARD detects prompt attacks in Sinhala and Tamil too, but needs a
# guardrail profile. CLASSIC covers English and always deploys.
GUARDRAIL_TIER=CLASSIC
GUARDRAIL_PROFILE_ID=us.guardrail.v1:0

# Shown to visitors when their document is held.
COLLECTION_POINT=Security desk, ground floor

# Stage 6: Knowledge Base on S3 Vectors for procedure questions.
ENABLE_KNOWLEDGE_BASE=true

REVIEW_TIMEOUT_HOURS=24
RECORD_TTL_DAYS=30
# Must be at least RECORD_TTL_DAYS.
IMAGE_RETENTION_DAYS=30

# Chat API throttling per API key.
API_RATE=2
API_BURST=5

PASSPORT_NUMBER_PATTERN=^[A-Z]\d{7}$
