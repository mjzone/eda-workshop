{
  "name": "eda-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Lost passport and NIC finder: a hands-on workshop on event-driven architecture and generative AI on AWS",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "synth": "cdk synth --quiet",
    "desk": "tsx desk-cli/index.ts",
    "seed": "tsx desk-cli/index.ts seed",
    "status": "tsx scripts/status.ts",
    "specimens": "tsx test-data/generate-specimens.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-sdk/client-api-gateway": "3.1164.0",
    "@aws-sdk/client-bedrock-agent": "3.1164.0",
    "@aws-sdk/client-bedrock-agent-runtime": "3.1164.0",
    "@aws-sdk/client-bedrock-agentcore": "3.1164.0",
    "@aws-sdk/client-bedrock-runtime": "3.1164.0",
    "@aws-sdk/client-cloudformation": "3.1164.0",
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/client-sfn": "3.1164.0",
    "@aws-sdk/lib-dynamodb": "3.1164.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@inquirer/prompts": "8.7.5",
    "aws-cdk-lib": "2.276.0",
    "constructs": "10.8.1",
    "dotenv": "17.2.3",
    "image-size": "2.1.0",
    "mupdf": "1.28.1",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
